{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retrieval Benchmark JSONL Record",
  "type": "object",
  "required": [
    "query",
    "privacy"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "expected_source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^src-[0-9a-f]{12}$"
      }
    },
    "expected_wiki_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*:)(?!.*//)(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))wiki/[^\\\\]+$"
      }
    },
    "expected_quotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "personal",
        "sensitive",
        "restricted"
      ]
    },
    "notes": {
      "type": "string"
    },
    "confirmed": {
      "type": "boolean"
    },
    "user_confirmed": {
      "type": "boolean"
    }
  },
  "anyOf": [
    {
      "required": [
        "expected_source_ids"
      ]
    },
    {
      "required": [
        "expected_wiki_paths"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "privacy": {
            "enum": [
              "sensitive",
              "restricted"
            ]
          }
        },
        "required": [
          "privacy"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "confirmed"
            ],
            "properties": {
              "confirmed": {
                "const": true
              }
            }
          },
          {
            "required": [
              "user_confirmed"
            ],
            "properties": {
              "user_confirmed": {
                "const": true
              }
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": true,
  "x-format": "jsonl"
}
