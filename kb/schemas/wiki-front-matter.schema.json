{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wiki Draft Front Matter",
  "type": "object",
  "required": [
    "draft_id",
    "title",
    "query",
    "created_at",
    "model",
    "prompt_hash",
    "context_sources",
    "context_chunks",
    "claims"
  ],
  "properties": {
    "draft_id": {
      "type": "string",
      "pattern": "^draft-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "prompt_hash": {
      "type": "string",
      "minLength": 1
    },
    "context_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^src-[0-9a-f]{12}$"
      }
    },
    "context_chunks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^src-[0-9a-f]{12}#[0-9]+$"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
