{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backup Manifest",
  "type": "object",
  "required": [
    "format_version",
    "created_at",
    "files"
  ],
  "properties": {
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "engine_version": {
      "type": "string"
    },
    "root_label": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "excluded": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
