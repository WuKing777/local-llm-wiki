{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile Registry",
  "type": "object",
  "required": [
    "profiles"
  ],
  "properties": {
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "root",
          "kind",
          "created_at",
          "last_health_status",
          "last_health_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^profile-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "last_health_status": {
            "type": "string",
            "minLength": 1
          },
          "last_health_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
